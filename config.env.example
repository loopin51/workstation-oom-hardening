# config.env.example
#
# 이 파일을 config.env 로 복사한 뒤 자신의 환경에 맞게 고치세요.
# install.sh / verify.sh / uninstall.sh 가 같은 디렉터리의 config.env 를 자동으로
# 읽습니다. config.env 는 .gitignore 에 들어 있으므로 커밋되지 않습니다.
#
#   cp config.env.example config.env && $EDITOR config.env
#
# 전부 선택 사항입니다. config.env 가 없으면 아래 기본값이 그대로 쓰입니다.

# ---------------------------------------------------------------------------
# NFS
# ---------------------------------------------------------------------------
# hard 로 마운트된 NFS 는 hung_task_panic=1 과 조합하면 서버가 다운될 때
# 접근 프로세스가 D 상태로 무한 대기하다 오탐 재부팅을 일으킨다.
# NFS_MOUNTS 에 적힌 마운트 지점의 옵션을 soft,softerr 로 바꾼다.
# 비워두면 NFS 단계를 통째로 건너뛴다. 공백으로 여러 개를 적을 수 있다.
NFS_MOUNTS=""
# 예: NFS_MOUNTS="/mnt/nas /mnt/backup"

# ---------------------------------------------------------------------------
# 하드웨어 워치독
# ---------------------------------------------------------------------------
# 비워두면 자동 판별한다: 칩셋 워치독(Intel iTCO_wdt / AMD sp5100_tco) ->
# BMC 워치독(/dev/ipmi0 이 있으면 ipmi_watchdog) -> softdog 폴백.
#
# 서버 보드는 BMC 가 TCO 영역을 점유해 칩셋 워치독이 안 붙는 경우가 많다.
# 커널 로그에 'lpc_ich ...: No MFD cells added' 가 보이면 이 경우다.
# 그때는 ipmi_watchdog 이 자동으로 선택된다. BMC 가 직접 도는 진짜 하드웨어
# 워치독이라 커널이 완전히 얼어붙어도 리셋이 걸린다.
WDT_MODULE=""

# systemd(PID 1)가 워치독을 핑하는 주기. 이 시간 동안 핑이 없으면 하드웨어 리셋.
RUNTIME_WATCHDOG="60"       # 초
REBOOT_WATCHDOG="10min"

# ---------------------------------------------------------------------------
# 원격 접속 경로 메모리 예약
# ---------------------------------------------------------------------------
# "유닛명:예약량" 형식. 존재하지 않는 유닛은 자동으로 건너뛴다.
# MemoryMin 은 상한이 아니라 예약이다. 이 양만큼은 메모리 회수(reclaim) 대상에서
# 제외되므로, 시스템이 아무리 쪼들려도 이 데몬들은 페이지를 뺏기지 않는다.
REMOTE_UNITS=(
  "ssh.service:64M"
  "ssh@.service:64M"          # socket-activated 연결 인스턴스
  "tailscaled.service:128M"
  "rustdesk.service:512M"     # 화면 캡처/인코딩 시 급증
  "gdm.service:256M"          # 원격 데스크톱이 붙는 디스플레이 세션
)
# SSH 로그인 세션이 생성되는 슬라이스
RSV_USER_SLICE="256M"

# 실행 중인 프로세스에 oom_score_adj 를 직접 쓸 대상 (재시작 없이 반영).
# 유닛을 restart 하면 지금 쓰고 있는 SSH 세션이 끊기므로 이 방식을 쓴다.
REMOTE_PROCS=(sshd tailscaled rustdesk gdm3)

# ---------------------------------------------------------------------------
# earlyoom
# ---------------------------------------------------------------------------
# "SIGTERM 임계치,SIGKILL 임계치" (사용 가능 메모리 백분율)
EARLYOOM_THRESHOLDS="10,5"
EARLYOOM_REPORT_INTERVAL="3600"   # 초. 0 이면 리포트 끔

# 절대 죽이면 안 되는 프로세스. 원격 접속 경로와 노드 관리 데몬.
# 주의: 프로세스 이름(comm)은 커널에서 15자로 잘리므로 긴 이름은 접두사로 매칭할 것.
EARLYOOM_AVOID='^(sshd|ssh|tailscaled|tailscale|rustdesk|systemd|systemd-.*|dbus-daemon|dbus-broker|gdm3|gdm-.*|gnome-shell|gnome-session.*|Xorg|Xwayland|NetworkManager|wpa_supplicant|login|agetty|sudo|su|bash|zsh|earlyoom|k3s-server|k3s|containerd|containerd-shim|dockerd|kubelet)$'

# 우선적으로 죽일 프로세스. 학습 워크로드와 메모리를 많이 먹는 앱.
EARLYOOM_PREFER='^(python3?|pt_main_thread|pt_data_worker|pt_autograd_.*|ray::.*|jupyter.*|torchrun|deepspeed|accelerate|node|next-server.*|chrome|java)$'

# ---------------------------------------------------------------------------
# 스왑
# ---------------------------------------------------------------------------
# 스왑이 켜져 있으면 OOM 대신 몇 시간짜리 스왑 스래싱으로 시스템이 응답 불능이 된다.
DISABLE_SWAP=1
# 1 이면 fstab 에 등록된 스왑 "파일"을 삭제해 디스크를 회수한다 (파티션은 건드리지 않음).
DELETE_SWAP_FILE=0

# ---------------------------------------------------------------------------
# sysctl
# ---------------------------------------------------------------------------
HUNG_TASK_TIMEOUT="120"     # 초. D 상태가 이 시간을 넘으면 패닉
PANIC_REBOOT_DELAY="10"     # 초. 패닉 후 재부팅까지

# inotify 한계. 기본값 128 instances 는 컨테이너를 여러 개 돌리면 쉽게 소진되어
# systemctl 이 "Failed to allocate directory watch: Too many open files" 를 낸다.
INOTIFY_INSTANCES="1024"
INOTIFY_WATCHES="524288"
